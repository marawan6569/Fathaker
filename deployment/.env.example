# Local development: copy to the repository root as .env (never into an image).
DEBLOYED=0
DEBUG=1
ALLOWEDHOSTS=localhost;127.0.0.1;[::1]
TRUSTEDORIGINS=
# Optional locally; use an isolated snapshot path for exports.
# SQLITE_PATH=/absolute/path/to/snapshot.sqlite3
# SECRETKEY=local-only-key

# Cloud Run runtime configuration (set through the service, not this file):
# DEBLOYED=1
# DEBUG=0
# ALLOWEDHOSTS=fathaker.com;www.fathaker.com;SERVICE.run.app
# TRUSTEDORIGINS=https://fathaker.com;https://www.fathaker.com;https://SERVICE.run.app
# GS_BUCKET_NAME=YOUR_PUBLIC_MEDIA_BUCKET
# SECRETKEY=<Secret Manager reference>
# DATABASE_URL=<Secret Manager reference to Neon pooled URL with sslmode=require>
# PORT is supplied by Cloud Run. No GOOGLE_APPLICATION_CREDENTIALS key file needed.
